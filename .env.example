# ============================================================================
# ITINFiling — Environment Variables
# For Hostinger: set these in hPanel → Website → Advanced → Environment Variables
# For local dev: copy this to .env and fill in the values
# ============================================================================

# --- Required: database (Hostinger-style individual vars) -------------------
DB_HOST="localhost"
DB_NAME="uXXXXXXXXX_name"
DB_USER="uXXXXXXXXX_user"
DB_PASSWORD="your-database-password"
DB_PORT="3306"

# --- Required: app ----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Session cookies + fallback key for the encrypted settings vault.
SESSION_SECRET="replace-with-a-long-random-string-32+chars"
# Dedicated AES key for stored credentials (Stripe/SMTP/bank). Falls back to
# SESSION_SECRET if unset; set a separate strong value in production.
SETTINGS_SECRET="replace-with-another-long-random-string-32+chars"

# --- Required: admin + super-admin accounts (seeded on build/deploy) --------
# Passwords are only set when the account is first created; re-seeds/deploys
# never overwrite them.
SEED_SUPERADMIN_EMAIL="superadmin@itinfiling.com"
SEED_SUPERADMIN_PASSWORD="change-me-at-least-12-chars"
SEED_ADMIN_EMAIL="admin@itinfiling.com"
SEED_ADMIN_PASSWORD="change-me-at-least-12-chars"

# --- Payments (Stripe). Can also be managed from the admin Settings UI, ------
#     which overrides these when set. ----------------------------------------
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"

# --- File storage (Cloudflare R2 / S3-compatible) — optional -----------------
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_BASE_URL="https://pub-xxx.r2.dev"

# --- Email / SMTP (optional here) -------------------------------------------
# Recommended: leave blank and configure no-reply + support SMTP and the Tide
# bank details from the admin dashboard Settings page. Setting the no-reply
# SMTP there is what enables login OTP and branded transactional emails.

# SEO: production origin (canonical URLs, sitemap, OG) and Google Search Console verification token
# NEXT_PUBLIC_APP_URL="https://itinready.com"
GOOGLE_SITE_VERIFICATION=""
